# AI assistant on the /about page.
# Any OpenAI-compatible chat completions endpoint works (OpenAI, NVIDIA NIM, Groq, OpenRouter, Together, Ollama, ...).

# Required. Without it the assistant renders in "offline" mode.
OPENAI_API_KEY=

# Firebase web app configuration (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studio-1605945732-d0a2d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://studio-1605945732-d0a2d-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studio-1605945732-d0a2d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=studio-1605945732-d0a2d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=291694258455
NEXT_PUBLIC_FIREBASE_APP_ID=1:291694258455:web:6572543d49d1abb6b0af52

# Server only. Paste the complete Firebase service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional. Point at a different provider or a local server.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Any chat model that supports streaming completions.
# OPENAI_MODEL=gpt-4o-mini

# Optional. Token budget for the answer. Reasoning models need a generous
# budget because their thinking tokens come out of the same allowance.
# OPENAI_MAX_TOKENS=4096

# Optional. Sampling temperature for the answer.
# OPENAI_TEMPERATURE=0.5

# Optional. NVIDIA NIM only. Set to true to let reasoning models think
# before answering. Leaving it off makes the first token arrive much sooner.
# OPENAI_ENABLE_THINKING=false

# --- NVIDIA NIM example ---
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# OPENAI_API_KEY=nvapi-...
